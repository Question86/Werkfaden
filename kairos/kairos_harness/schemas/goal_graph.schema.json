{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kairos:schema:goal-graph:v1",
  "title": "KAIROS goal graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "objective", "state", "milestones"],
  "properties": {
    "schema": { "const": "kairos-goal/v1" },
    "id": { "type": "string", "pattern": "^GOAL_[A-Z0-9_.:-]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "objective": { "type": "string", "minLength": 8, "maxLength": 2000 },
    "state": { "enum": ["new", "active", "blocked", "completed", "superseded"] },
    "created_at": { "type": "string", "format": "date-time" },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "objective", "state", "depends_on", "criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^MILESTONE_[A-Z0-9_.:-]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "objective": { "type": "string", "minLength": 8, "maxLength": 2000 },
          "state": { "enum": ["new", "active", "blocked", "completed", "superseded"] },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^MILESTONE_[A-Z0-9_.:-]+$" },
            "uniqueItems": true
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "description", "state", "evidence_required", "required_artifact_types"],
              "properties": {
                "id": { "type": "string", "pattern": "^CRIT_[A-Z0-9_.:-]+$" },
                "description": { "type": "string", "minLength": 8, "maxLength": 2000 },
                "state": { "enum": ["open", "active", "blocked", "completed", "waived"] },
                "evidence_required": { "type": "string", "minLength": 8, "maxLength": 2000 },
                "required_artifact_types": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": ["report", "bug", "code", "decision", "research", "archive", "documentation"]
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  }
}

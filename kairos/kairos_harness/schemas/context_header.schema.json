{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kairos:schema:context-header:v1",
  "title": "KAIROS context header",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "id",
    "type",
    "revision",
    "state",
    "authority",
    "workspace",
    "route",
    "updated_at",
    "capsule",
    "claim_boundary",
    "entities",
    "facets",
    "criteria",
    "does_not_answer",
    "answers",
    "refs",
    "search_contract"
  ],
  "properties": {
    "schema": { "const": "kairos-context/v1" },
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.:-]{2,127}$" },
    "type": {
      "enum": [
        "task",
        "report",
        "bug",
        "code",
        "decision",
        "research",
        "archive",
        "router",
        "gate",
        "session",
        "documentation",
        "transaction"
      ]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": [
        "new",
        "ready",
        "active",
        "in_progress",
        "partial",
        "success",
        "failed",
        "blocked",
        "resolved",
        "completed",
        "superseded",
        "finalized"
      ]
    },
    "authority": {
      "enum": [
        "architecture_authority",
        "diagnostic_record",
        "execution_evidence",
        "goal_authority",
        "implementation_documentation",
        "loop_archive",
        "operating_contract",
        "research_evidence",
        "routing",
        "state_authority",
        "task_contract",
        "validation_evidence"
      ]
    },
    "workspace": { "type": "string", "minLength": 1, "maxLength": 128 },
    "route": { "type": "string", "minLength": 1, "maxLength": 512 },
    "loop": { "type": "integer", "minimum": 1 },
    "task": { "type": "string", "pattern": "^TASK_[A-Z0-9_.:-]+$" },
    "goal": { "type": "string", "pattern": "^GOAL_[A-Z0-9_.:-]+$" },
    "milestone": { "type": "string", "pattern": "^MILESTONE_[A-Z0-9_.:-]+$" },
    "updated_at": { "type": "string", "format": "date-time" },
    "capsule": { "type": "string", "minLength": 1, "maxLength": 480 },
    "claim_boundary": { "type": "string", "minLength": 1, "maxLength": 480 },
    "entities": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    },
    "facets": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
      "uniqueItems": true
    },
    "criteria": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^CRIT_[A-Z0-9_.:-]+$" },
      "uniqueItems": true
    },
    "does_not_answer": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent", "question", "target"],
        "properties": {
          "intent": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,47}$" },
          "question": { "type": "string", "minLength": 8, "maxLength": 512 },
          "target": { "type": "string", "pattern": "^s-[a-z0-9][a-z0-9-]{1,62}$" },
          "language": { "const": "en" },
          "weight": { "type": "number", "minimum": 0, "maximum": 10 }
        }
      }
    },
    "refs": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\[ref:[^|\\]]+(?:\\|id:[^|\\]]+)?\\|v:[^|\\]]+\\|rel:[a-z_]+\\|tags:[^|\\]]+\\|src:[^\\]]+\\]$"
      }
    },
    "search_contract": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "expected", "required_top_k"],
        "properties": {
          "query": { "type": "string", "minLength": 8, "maxLength": 512 },
          "expected": { "type": "string", "maxLength": 256, "pattern": "^[A-Z][A-Z0-9_.:-]+#s-[a-z0-9][a-z0-9-]{1,62}$" },
          "required_top_k": { "type": "integer", "minimum": 1, "maximum": 50 }
        }
      }
    }
  }
}
